
CREATE TABLE Item (
        id BIGINT AUTO_INCREMENT,
        base_id VARCHAR(255) NOT NULL,
        docid_col VARCHAR(255) NOT NULL,
        fulltext_col LONGTEXT
    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

